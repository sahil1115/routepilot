# Prettier is configured with endOfLine: "lf", so the repository stores and
# checks out LF on every platform. Without this, core.autocrlf=true on Windows
# gives the next clone CRLF in every file and `npm run format:check` fails
# before a single line has been edited.
* text=auto eol=lf

# Never normalise these.
*.png binary
*.jpg binary
*.ico binary
*.vsix binary
*.sqlite binary
