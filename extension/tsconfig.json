{
  "compilerOptions": {
    "target": "ES2022",
    // Node16 rather than CommonJS: the extension host loads CommonJS, but the
    // RoutePilot core is ESM. Under Node16 module resolution TypeScript emits
    // `require` for static imports and **preserves** dynamic `import()`, which
    // is what lets a CommonJS extension load an ESM library at all.
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "out",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
