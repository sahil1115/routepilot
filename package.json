{
  "name": "routepilot",
  "version": "0.3.0",
  "private": true,
  "description": "RoutePilot â€” choose the cheapest path to success. An intelligent coding-agent model router.",
  "author": "Sahil",
  "contributors": [
    "Sahil"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahil1115/routepilot.git"
  },
  "homepage": "https://github.com/sahil1115/routepilot#readme",
  "bugs": {
    "url": "https://github.com/sahil1115/routepilot/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "config/routepilot.example.json",
    "config/README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "verify:adapters": "npm run build && node scripts/verify-adapter.mjs",
    "build:extension": "npm run build && npm --prefix extension install --no-audit --no-fund && node scripts/sync-extension-core.mjs && tsc -p extension/tsconfig.json",
    "verify:extension": "npm run build:extension && node scripts/verify-package.mjs && node extension/scripts/verify-extension.cjs",
    "package:extension": "npm run build:extension && node scripts/verify-package.mjs && npm --prefix extension run package",
    "bench": "npm run build && node bench/benchmark.mjs",
    "phase": "node scripts/phase-check.mjs",
    "gate": "node scripts/quality-gate.mjs",
    "verify:vscode": "npm run build:extension && node scripts/run-vscode-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "bin": {
    "routepilot": "./dist/cli/main.js"
  }
}
